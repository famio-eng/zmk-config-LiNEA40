#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "boards/shields/LiNEA40/jp.h"

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6


//mouse cursol
&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll
&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>;
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        DeleteKey { bindings = <&kp DEL>; key-positions = <8 7>; };
        InsertKey { bindings = <&kp INS>; key-positions = <6 7>; };
        Enter { bindings = <&kp ENTER>; key-positions = <18 17 16>; };
        PrevClick { bindings = <&mkp MB4>; key-positions = <16 17>; };
        ClickNext { bindings = <&mkp MB5>; key-positions = <17 18>; };
        back { bindings = <&kp BACKSPACE>; key-positions = <8 9>; };
        screenshot { bindings = <&kp PRINTSCREEN>; key-positions = <3 4>; };
        emoji { bindings = <&kp LG(PERIOD)>; key-positions = <2 3>; };
        escape { bindings = <&kp ESCAPE>; key-positions = <1 2>; };
        tab { bindings = <&kp TAB>; key-positions = <11 12>; };
        EN { bindings = <&kp LANG2>; key-positions = <12 13>; };
        JP { bindings = <&kp LANG1>; key-positions = <22 23>; };
        katakana { bindings = <&kp LANG3>; key-positions = <0 1>; };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

    /* 1. JIS記号の定義 */
        jp_at_key: jp_at_key {
            compatible = "zmk,behavior-tap";
            #binding-cells = <1>;
            label = "JP_@";
            bindings = <&kp JP_AT>;
        };

        jp_quot_key: jp_quot_key {
            compatible = "zmk,behavior-tap";
            #binding-cells = <1>;
            label = "JP_\"";
            bindings = <&kp JP_QUOT>;
        };

