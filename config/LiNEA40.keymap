#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "jp.dtsi"

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6


//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <8 7>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <18 17 16>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <16 17>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <17 18>;
        };

        back {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        screenshot {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <3 4>;
        };

        emoji {
            bindings = <&kp LG(PERIOD)>;
            key-positions = <2 3>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        EN {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        JP {
            bindings = <&kp LANG1>;
            key-positions = <22 23>;
        };

        katakana {
            bindings = <&kp LANG3>;
            key-positions = <0 1>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

    /* 1. JIS記号の定義 */
        jp_at: jp_at {
            compatible = "zmk,behavior-tap";
            label = "JP_@";
            bindings = <&kp JP_AT>;
        };

        jp_quot: jp_quot {
            compatible = "zmk,behavior-tap";
            label = "JP_\"";
            bindings = <&kp JP_QUOT>;
        };

        jp_colon: jp_colon {
            compatible = "zmk,behavior-tap";
            label = "JP_:";
            bindings = <&kp JP_COLON>;
        };

        jp_under: jp_under {
            compatible = "zmk,behavior-tap";
            label = "JP__";
            bindings = <&kp JP_UNDER>;
        };

        jp_caret: jp_caret {
            compatible = "zmk,behavior-tap";
            label = "JP_^";
            bindings = <&kp JP_CARET>;
        };

        jp_tild: jp_tild {
            compatible = "zmk,behavior-tap";
            label = "JP_~";
            bindings = <&kp JP_TILD>;
        };

        jp_plus: jp_plus {
            compatible = "zmk,behavior-tap";
            label = "JP_+";
            bindings = <&kp JP_PLUS>;
        };

        jp_asterisk: jp_asterisk {
            compatible = "zmk,behavior-tap";
            label = "JP_*";
            bindings = <&kp JP_ASTR>;
        };

        jp_equal: jp_equal {
            compatible = "zmk,behavior-tap";
            label = "JP_=";
            bindings = <&kp JP_EQL>;
        };

        jp_yen: jp_yen {
            compatible = "zmk,behavior-tap";
            label = "JP_\\";
            bindings = <&kp JP_YEN>;
        };

    /* 2. 日本語入力切り替え関連の定義 */
        jp_eisu: jp_eisu {
            compatible = "zmk,behavior-tap";
            label = "JP_EISU";
            bindings = <&kp JP_EISU>;
        };

        jp_kana: jp_kana {
            compatible = "zmk,behavior-tap";
            label = "JP_KANA";
            bindings = <&kp JP_KANA>;
        };

        jp_hanzen: jp_hanzen {
            compatible = "zmk,behavior-tap";
            label = "JP_HANZEN";
            bindings = <&kp JP_HANZEN>;
        };
        
    /* 3. その他（中括弧や丸括弧など）の定義 */
        jp_lpar: jp_lpar {
            compatible = "zmk,behavior-tap";
            label = "JP_(";
            bindings = <&kp JP_LPAR>;
        };

        jp_rpar: jp_rpar {
            compatible = "zmk,behavior-tap";
            label = "JP_)";
            bindings = <&kp JP_RPAR>;
        };

        jp_lcbr: jp_lcbr {
            compatible = "zmk,behavior-tap";
            label = "JP_{";
            bindings = <&kp JP_LCBR>;
        };

        jp_rcbr: jp_rcbr {
            compatible = "zmk,behavior-tap";
            label = "JP_}";
            bindings = <&kp JP_RCBR>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_win {
            bindings = <
&kp Q             &kp W         &kp E               &kp R  &kp T                                  &kp Y        &kp U  &kp I             &kp O             &lt 6 P
&kp A             &kp S         &kp D               &kp F  &kp G                                  &kp H        &kp J  &kp K             &kp L             &lt 5 BACKSPACE
&kp LEFT_SHIFT    &kp Z         &kp X               &kp C  &kp V                                  &kp B        &kp N  &kp M             &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD
&kp LEFT_CONTROL  &kp LEFT_WIN  &mt LEFT_ALT GRAVE  &none  &mo 5             &mo 7    &lt 3 ENTER  &lt 4 SPACE         &lt 7 QUESTION  &kp LS(NUMBER_6)     &mt UNDERSCORE MINUS
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        default_layer_mac {
            bindings = <
&kp Q             &kp W         &kp E               &kp R  &kp T                                  &kp Y        &kp U  &kp I                &kp O                    &lt 6 P
&kp A             &kp S         &kp D               &kp F  &kp G                                  &kp H        &kp J  &kp K                &kp L                    &lt 5 MINUS
&kp Z             &kp X         &kp C               &kp V  &kp B                                  &kp N        &kp M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH
&kp LEFT_CONTROL  &kp LEFT_WIN  &mt LEFT_ALT GRAVE  &none  &mo 5             &mo 7    &lt 3 TAB    &lt 4 ENTER         &lt 6 QUESTION       &kp BACKSLASH            &jp_under
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans     &trans     &trans        &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK     &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp LCLK  &mkp MCLK  &kp UP_ARROW  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans             &trans     &trans        &trans
            >;
        };

        MARK {
            bindings = <
&kp EXCLAMATION   &jp_quot      &kp HASH          &kp DOLLAR     &kp PERCENT                                  &kp LS(NUMBER_6)  &jp_quot      &jp_lpar          &jp_rpar             &kp SLASH
&kp SLASH         &kp KP_NUMBER_4  &kp KP_NUMBER_5   &kp SCLN       &kp SCLN                                     &jp_tild          &jp_plus      &jp_asterisk      &jp_at               &jp_lcbr
&kp LEFT_SHIFT    &kp KP_NUMBER_1  &kp KP_NUMBER_2   &kp APOS       &kp SQT                                      &jp_caret         &kp SCLN      &jp_colon         &jp_asterisk         &jp_rcbr
&trans            &trans           &trans            &trans         &trans         &trans    &trans  &trans                                       &kp QUESTION     &jp_at               &jp_under
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUMBER {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                    &kp NUMBER_6        &kp N7              &kp N8               &kp N9  &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                    &kp F6              &kp LG(UP_ARROW)    &kp F8               &kp F9  &kp F10
&trans        &trans        &trans        &trans        &trans                    &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans    &trans  &trans                                  &trans               &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp LG(UP_ARROW)  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8    &kp NUMBER_9    &kp KP_PLUS
&trans    &kp LG(LEFT_ARROW)      &kp LG(DOWN)      &kp LG(RIGHT_ARROW)      &trans                    &kp KP_SLASH     &mkp LCLK     &mkp MCLK       &mkp RCLK       &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END           &kp PAGE_UP              &trans                    &jp_under        &kp NUMBER_1  &kp NUMBER_2    &kp UP_ARROW    &kp ENTER
&trans    &trans                  &trans            &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        CURSOR {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp LG(UP_ARROW)  &kp LC(LG(RIGHT_ARROW))  &trans                    &trans  &trans  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN
&trans    &kp LG(LEFT_ARROW)      &kp LG(DOWN)      &kp LG(RIGHT_ARROW)      &trans                    &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
&kp HOME  &trans                  &trans            &trans                   &trans                    &trans  &trans  &trans          &trans          &trans
&trans    &trans                  &trans            &trans                   &trans  &trans    &trans  &trans          &trans          &kp HOME        &kp END
            >;
        };
    };
};
