#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* --- STEP 1: レイヤー番号の定義 --- */
#define WIN      0
#define MAC      1
#define MOUSE    2
#define MARK     3
#define CURSOR   4
#define NUMBER   5
#define SCROLL   6
#define WIRELESS 7

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 600

/* --- STEP 2: マウス・スクロールの挙動設定 --- */
&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <20>;
    acceleration-exponent = <1>;
};

&msc {
    delay-ms = <0>;
    trigger-period-ms = <12>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

/ {
    /* --- STEP 2: トラックボール・リスナーの正常化 --- */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";

        scroller {
            layers = <SCROLL>;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };

    /* --- STEP 5: コンボ定義 --- */
    combos {
        compatible = "zmk,combos";
        DeleteKey { bindings = <&kp DEL>; key-positions = <8 7>; };
        InsertKey { bindings = <&kp INS>; key-positions = <6 7>; };
        Enter { bindings = <&kp ENTER>; key-positions = <18 17 16>; };
        PrevClick { bindings = <&mkp MB4>; key-positions = <16 17>; };
        ClickNext { bindings = <&mkp MB5>; key-positions = <17 18>; };
        back { bindings = <&kp BACKSPACE>; key-positions = <8 9>; };
        screenshot { bindings = <&kp PRINTSCREEN>; key-positions = <4 3>; };
        emoji { bindings = <&kp LG(PERIOD)>; key-positions = <3 1>; };
        escape { bindings = <&kp ESCAPE>; key-positions = <1 0>; };
        tab { bindings = <&kp TAB>; key-positions = <11 12>; };
        EN { bindings = <&kp LANG2>; key-positions = <12 13>; };
        JP { bindings = <&kp LANG1>; key-positions = <22 23>; };
        katakana { bindings = <&kp LANG3>; key-positions = <23 24>; };
    };

    /* --- STEP 6: 振る舞い（Behaviors）の定義 --- */
    behaviors {
        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            /* 延々スクロールを防ぐため、単純なKPではなく MSC を直接制御 */
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <30>;
        };
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };
    };

    /* --- STEP 7: 日本語JIS記号マクロの定義 --- */
    macros {
        j_dq: j_dq { label = "DQ"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(N2)>; };
        j_amp: j_amp { label = "AMP"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(N6)>; };
        j_sq: j_sq { label = "SQ"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(N7)>; };
        j_eq: j_eq { label = "EQ"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(MINUS)>; };
        j_caret: j_cr { label = "CARET"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp EQUAL>; };
        j_yen: j_yen { label = "YEN"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp INT1>; };
        j_plus: j_plus { label = "PLUS"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp COLON>; };
        j_tilde: j_tilde { label = "TILDE"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp PLUS>; };
        j_pipe: j_pipe { label = "PIPE"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(INT1)>; };
        j_at: j_at { label = "AT"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LBKT>; };
        j_colon: j_colon { label = "COLON"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp SQT>; };
        j_ast: j_ast { label = "AST"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(SQT)>; };
        j_bt: j_bt { label = "BT"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(RBKT)>; };
        j_under: j_under { label = "UNDER"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(INT1)>; };
        j_lbkt: j_lbkt { label = "L_BKT"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RBKT>; };
        j_rbkt: j_rbkt { label = "R_BKT"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp BACKSLASH>; };
        j_lp: j_lp { label = "L_PAREN"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ASTRK>; };
        j_rp: j_rp { label = "R_PAREN"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LEFT_PARENTHESIS>; };
        j_lbrc: j_lbrc { label = "L_BRACE"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RIGHT_BRACE>; };
        j_rbrc: j_rbrc { label = "R_BRACE"; compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(BSLH)>; };
    };

    /* --- STEP 8: キーマップ本体 --- */
    keymap {
        compatible = "zmk,keymap";

        WIN {
            bindings = <
&kp Q             &kp W         &kp E         &kp R  &kp T                                     &kp Y         &kp U  &kp I                &kp O                    &kp P
&kp A             &kp S         &kp D         &kp F  &kp G                                     &kp H         &kp J  &kp K                &kp L                    &lt SCROLL BACKSPACE
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V  &kp B                                     &kp N         &kp M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &none  &kp LEFT_SHIFT  &kp LCTRL    &lt NUMBER ENTER  &lt MARK SPACE          &lt CURSOR QUESTION       &kp ENTER                &lt WIRELESS TAB
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        MAC {
            bindings = <
&kp Q             &kp W         &kp E         &kp R  &kp T                                     &kp Y         &kp U  &kp I                &kp O                    &kp P
&kp A             &kp S         &kp D         &kp F  &kp G                                     &kp H         &kp J  &kp K                &kp L                    &lt SCROLL MINUS
&kp Z             &kp X         &kp C         &kp V  &kp B                                     &kp N         &kp M  &kp COMMA            &kp DOT                  &mt RIGHT_SHIFT BACKSPACE
&mt LCTRL ESC     &kp LEFT_COMMAND &mt LEFT_ALT GRAVE &kp INS &lt SCROLL ENTER &lt MARK TAB &lt MARK BACKSPACE &lt NUMBER SPACE          &lt WIRELESS SEMICOLON      &kp INT_YEN              &mt RIGHT_SHIFT SLASH
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp LCLK        &mkp RCLK         &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MCLK        &trans            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                    &trans            &trans  &trans
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        MARK {
            bindings = <
&kp EXCLAMATION  &j_dq            &kp HASH  &kp DOLLAR  &kp PERCENT                    &j_amp  &j_sq          &j_under   &j_tilde      &j_yen
&kp SLASH        &j_pipe          &j_lbrc   &j_lbkt     &j_lp                          &j_eq   &j_plus        &kp MINUS  &j_caret      &j_at
&kp LEFT_SHIFT   &kp KP_NUMBER_1  &j_rbrc   &j_rbkt     &j_rp                          &j_ast  &kp SEMICOLON  &j_colon   &kp QUESTION  &kp SLASH
&trans           &trans           &trans    &trans      &trans        &trans    &trans  &trans                   &kp SLASH  &trans        &trans
            >;
            sensor-bindings = <&re_kp>;
        };

        CURSOR {
            bindings = <
&trans          &kp LC(LG(LEFT_ARROW))  &kp LG(UP_ARROW)  &kp LC(LG(RIGHT_ARROW))  &trans                    &trans  &trans  &kp PG_DN        &kp UP_ARROW    &kp PG_UP
&trans          &kp LG(LEFT_ARROW)      &kp LG(DOWN)      &kp LG(RIGHT_ARROW)      &trans                    &trans  &trans  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW
&kp LEFT_SHIFT  &trans                  &trans            &trans                   &trans                    &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
&trans          &trans                  &trans            &trans                   &trans  &trans    &trans  &trans          &trans          &kp HOME        &kp END
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        NUMBER {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                              &kp NUMBER_6            &kp N7              &kp N8                   &kp N9  &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                              &kp LG(LS(LEFT_ARROW))  &kp LG(UP_ARROW)    &kp LG(LS(RIGHT_ARROW))  &kp F9  &kp F10
&kp F6        &kp F7        &kp F8        &trans        &trans                              &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &trans  &trans
&trans        &trans        &trans        &trans        &kp INT_MUHENKAN  &trans    &trans  &trans                                                               &trans  &trans
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        SCROLL {
            bindings = <
&trans          &kp LC(LG(LEFT_ARROW))  &kp LG(UP_ARROW)  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8    &kp NUMBER_9    &kp KP_PLUS
&trans          &kp LG(LEFT_ARROW)      &kp LG(DOWN)      &kp LG(RIGHT_ARROW)      &trans                    &kp KP_SLASH     &mkp LCLK     &mkp RCLK       &mkp RCLK       &kp KP_MINUS
&kp LEFT_SHIFT  &kp PAGE_DOWN            &kp END           &kp PAGE_UP              &trans                    &kp UNDER        &mkp MCLK     &mkp MCLK       &kp UP_ARROW    &kp ENTER
&trans          &trans                  &trans            &trans                   &trans  &trans    &trans  &kp NUMBER_0                    &kp LEFT_ARROW  &kp DOWN_ARROW  &trans
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                   &trans &trans &trans &trans &bt BT_CLR_ALL
&trans        &trans        &trans        &trans        &trans                         &trans &trans &trans &trans &bt BT_CLR
&trans        &trans        &trans        &trans        &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans        &trans  &trans &studio_unlock        &trans &trans &trans
            >;
        };
    };
};
