#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "jp.dtsi"

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6


//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <8 7>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <18 17 16>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <16 17>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <17 18>;
        };

        back {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        screenshot {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <3 4>;
        };

        emoji {
            bindings = <&kp LG(PERIOD)>;
            key-positions = <2 3>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        EN {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        JP {
            bindings = <&kp LANG1>;
            key-positions = <22 23>;
        };

        katakana {
            bindings = <&kp LANG3>;
            key-positions = <0 1>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

    /* 1. JIS記号の定義 */
        jp_at: jp_at {
            compatible = "zmk,behavior-tap";
            label = "JP_@";
            bindings = <&kp JP_AT>;
        };

        jp_quot: jp_quot {
            compatible = "zmk,behavior-tap";
            label = "JP_\"";
            bindings = <&kp JP_QUOT>;
        };

        jp_colon: jp_colon {
            compatible = "zmk,behavior-tap";
            label = "JP_:";
            bindings = <&kp JP_COLON>;
        };

        jp_under: jp_under {
            compatible = "zmk,behavior-tap";
            label = "JP__";
            bindings = <&kp JP_UNDER>;
        };

        jp_caret: jp_caret {
            compatible = "zmk,behavior-tap";
            label = "JP_^";
            bindings = <&kp JP_CARET>;
        };

        jp_tild: jp_tild {
            compatible = "zmk,behavior-tap";
            label = "JP_~";
            bindings = <&kp JP_TILD>;
        };

        jp_plus: jp_plus {
            compatible = "zmk,behavior-tap";
            label = "JP_+";
            bindings = <&kp JP_PLUS>;
        };

        jp_asterisk: jp_asterisk {
            compatible = "zmk,behavior-tap";
            label = "JP_*";
            bindings = <&kp JP_ASTR>;
        };

        jp_equal: jp_equal {
            compatible = "zmk,behavior-tap";
            label = "JP_=";
            bindings = <&kp JP_EQL>;
        };

        jp_yen: jp_yen {
            compatible = "zmk,behavior-tap";
            label = "JP_\\";
            bindings = <&kp JP_YEN>;
        };

    /* 2. 日本語入力切り替え関連の定義 */
        jp_eisu: jp_eisu {
            compatible = "zmk,behavior-tap";
            label = "JP_EISU";
            bindings = <&kp JP_EISU>;
        };

        jp_kana: jp_kana {
            compatible = "zmk,behavior-tap";
            label = "JP_KANA";
            bindings = <&kp JP_KANA>;
        };

        jp_hanzen: jp_hanzen {
            compatible = "zmk,behavior-tap";
            label = "JP_HANZEN";
            bindings = <&kp JP_HANZEN>;
        };
        
    /* 3. その他（中括弧や丸括弧など）の定義 */
        jp_lpar: jp_lpar {
            compatible = "zmk,behavior-tap";
            label = "JP_(";
            bindings = <&kp JP_LPAR>;
        };

        jp_rpar: jp_rpar {
            compatible = "zmk,behavior-tap";
            label = "JP_)";
            bindings = <&kp JP_RPAR>;
        };

        jp_lcbr: jp_lcbr {
            compatible = "zmk,behavior-tap";
            label = "JP_{";
            bindings = <&kp JP_LCBR>;
        };

        jp_rcbr: jp_rcbr {
            compatible = "zmk,behavior-tap";
            label = "JP_}";
            bindings = <&kp JP_RCBR>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_win {
            bindings = <
&kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &lt 6 P
&kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &lt 5 BACKSPACE
&kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &mt LESS_THAN COMMA &mt GREATER_THAN PERIOD
&kp LEFT_CONTROL &kp LEFT_WIN &mt LEFT_ALT GRAVE &none &mo 5 &mo 7 &lt 3 ENTER &lt 4 SPACE &lt 7 QUESTION &
