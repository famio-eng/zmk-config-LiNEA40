#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 600 

/* レイヤー定義 */
#define MOUSE 2
#define MARK 3
#define CURSOR 4
#define NUMBER 5
#define SCROLL 6
#define WIRELESS 7

// OS設定変換定義
#define JP_DQUOTE       AT
#define JP_AMPERSAND    CARET
#define JP_QUOTE        AMPERSAND
#define JP_EQUAL        UNDER
#define JP_CARET        EQUAL
#define JP_YEN          0x89
#define JP_PLUS         COLON
#define JP_TILDE        PLUS
#define JP_PIPE         LS(0x89)
#define JP_AT           LEFT_BRACKET
#define JP_COLON        SINGLE_QUOTE
#define JP_ASTERISK     DOUBLE_QUOTES
#define JP_BACKQUOTE    LEFT_BRACE
#define JP_UNDERSCORE   LS(0x87)
#define JP_LBRACKET     RIGHT_BRACKET
#define JP_RBRACKET     BACKSLASH
#define JP_LPAREN       ASTERISK
#define JP_RPAREN       LEFT_PARENTHESIS
#define JP_LBRACE       RIGHT_BRACE
#define JP_RBRACE       PIPE
#define JP_KANA         LANGUAGE_1
#define JP_EISU         LANGUAGE_2
#define JP_HANZEN       GRAVE

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <20>;
    acceleration-exponent = <1>;
};

&msc {
    delay-ms = <0>;
    trigger-period-ms = <12>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

/* dtsiにあるラベルを使用してリスナーを設定 */
/* すでに right.overlay で device = <&trackball> が定義されているため、
   ここでは追加したい設定（status, input-processors 等）のみを記述します */
/ {
    /* 参照（&）ではなく、ここでノードを定義・ラベル付けする */
    /* 1. リスナー定義 */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";

        /* 変換プロセッサとオートマウスプロセッサを並べる */
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&auto_mouse_layer 0>;

        /* 【重要】スクロール切り替えはここだけで定義する */
        scroller {
            layers = <6>;      /* レイヤー6にいる時だけスクロールになる */
            input-processors = <&zip_xy_to_scroll_mapper>;
        };
    };

    /* 2. オートマウスのロジック定義 */
    auto_mouse_layer {
        compatible = "zmk,input-processor-auto-mouse-layer";
        #input-processor-cells = <1>;
        layers = <2>;           /* MOUSEレイヤー(2)を指定 */
        timeout-ms = <500>;     /* タイムアウト設定 */
    };
};

/ {
    /*
    left_encoder_proc: left_encoder_proc {
        compatible = "zmk,behavior-runtime-sensor-rotate";
        #sensor-binding-cells = <0>;
    };*/

    combos {
        compatible = "zmk,combos";

        DeleteKey {  
            bindings = <&kp DEL>;  
            key-positions = <8 7>; 
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <18 17 16>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <16 17>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <17 18>;
        };

        back {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        screenshot {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <4 3>;
        };

        emoji {
            bindings = <&kp LG(PERIOD)>;
            key-positions = <3 1>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        EN {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        JP {
            bindings = <&kp LANG1>;
            key-positions = <22 23>;
        };

        katakana {
            bindings = <&kp LANG3>;
            key-positions = <23 24>;
        };
    };

    behaviors {
        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };
    };

/* ---------------------------------------------------------------------- */
    /* 日本語入力用カスタムマクロ定義 (視認性を優先し、エラー箇所のみ略称化) */
    /* ---------------------------------------------------------------------- */
    /* ---------------------------------------------------------------------- */
    /* 日本語入力用カスタムマクロ定義 (ビルド成功を優先し全て略称ラベルを使用) */
    /* ---------------------------------------------------------------------- */

    macros {
        /* " (ダブルクォート) | US: Shift + 2 */

        j_dq: j_dq {
            label = "DQ";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N2)>;
        };

        /* & (アンパサンド) | US: Shift + 6 */

        j_amp: j_amp {
            label = "AMP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N6)>;
        };

        /* ' (シングルクォート) | US: Shift + 7 */

        j_sq: j_sq {
            label = "SQ";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>;
        };

        /* = (イコール) | US: Shift + - */

        j_eq: j_eq {
            label = "EQ";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>;
        };

        /* ^ (ハット/キャレット) | US: \ (Backslash) */

        j_caret: j_cr {
            label = "CARET";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>;
        };

        /* ¥ (円マーク/バックスラッシュ) | US: INT1 */

        j_yen: j_yen {
            label = "YEN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT1>;
        };

        /* + (プラス) | US: ; (Semi-colon) */

        j_plus: j_plus {
            label = "PLUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON>;
        };

        /* ~ (チルダ) | US: Shift + = */

        j_tilde: j_tilde {
            label = "TILDE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PLUS>;
        };

        /* | (パイプ) | US: Shift + INT1 (¥) */

        j_pipe: j_pipe {
            label = "PIPE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(INT1)>;
        };

        /* @ (アットマーク) | US: [ (Left Bracket) */

        j_at: j_at {
            label = "AT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT>;
        };

        /* : (コロン) | US: ' (Single Quote) */

        j_colon: j_colon {
            label = "COLON";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT>;
        };

        /* * (アスタリスク) | US: Shift + ' */

        j_ast: j_ast {
            label = "AST";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SQT)>;
        };

        /* ` (バッククォート) | US: Shift + ] */

        j_bt: j_bt {
            label = "BT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(RBKT)>;
        };

        /* _ (アンダースコア) | US: Shift + INT1 (¥) */

        j_under: j_under {
            label = "UNDER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(INT1)>;
        };

        /* [ (左角括弧) | US: ] (Right Bracket) */

        j_lbkt: j_lbkt {
            label = "L_BKT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT>;
        };

        /* ] (右角括弧) | US: Shift + [ */

        j_rbkt: j_rbkt {
            label = "R_BKT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>;
        };

        /* ( (左丸括弧) | US: Shift + 8 */

        j_lp: j_lp {
            label = "L_PAREN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ASTRK>;
        };

        /* ) (右丸括弧) | US: Shift + 9 */

        j_rp: j_rp {
            label = "R_PAREN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>;
        };

        /* { (左波括弧) | US: Shift + [ (Left Bracket) */

        j_lbrc: j_lbrc {
            label = "L_BRACE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACE>;
        };

        /* } (右波括弧) | US: Shift + \ (Backslash) */

        j_rbrc: j_rbrc {
            label = "R_BRACE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(BSLH)>;
        };
    };

    /* ZMK標準の日本語入力切り替えキー（マクロ化不要） */

    behaviors {
        // キーバインディングとして直接利用します。
        // &kp KANA
        // &kp EISU
        // &kp GRAVE
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer_win {
            bindings = <
&kp Q             &kp W         &kp E         &kp R  &kp T                                     &kp Y        &kp U  &kp I                &kp O                    &kp P
&kp A             &kp S         &kp D         &kp F  &kp G                                     &kp H        &kp J  &kp K                &kp L                    &lt 6 BACKSPACE
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V  &kp B                                     &kp N        &kp M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &none  &kp LEFT_SHIFT  &kp LCTRL    &lt 5 ENTER  &lt 3 SPACE         &lt 4 QUESTION       &kp ENTER                &lt 7 TAB
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        default_layer_mac {
            bindings = <
                &kp Q          &kp W          &kp E                &kp R    &kp T                                    &kp Y        &kp U     &kp I            &kp O        &kp P
                &kp A          &kp S          &kp D                &kp F    &kp G                                    &kp H        &kp J     &kp K            &kp L        &lt 6 MINUS
                &kp Z          &kp X          &kp C                &kp V    &kp B                                    &kp N        &kp M     &kp COMMA        &kp DOT      &mt RIGHT_SHIFT BACKSPACE
                &mt LCTRL ESC  &kp LEFT_COMMAND &mt LEFT_ALT GRAVE &kp INS  &lt 6 ENTER  &lt 3 TAB  &lt 3 BACKSPACE  &lt 5 SPACE            &lt 7 SEMICOLON  &kp INT_YEN  &mt RIGHT_SHIFT SLASH
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp LCLK       &mkp RCLK        &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MCLK       &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans           &trans  &trans
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        MARK {
            bindings = <
&kp EXCLAMATION  &j_dq            &kp HASH  &kp DOLLAR  &kp PERCENT                    &j_amp  &j_sq          &j_under   &j_tilde      &j_yen
&kp SLASH        &j_pipe          &j_lbrc   &j_lbkt     &j_lp                          &j_eq   &j_plus        &kp MINUS  &j_caret      &j_at
&kp LEFT_SHIFT   &kp KP_NUMBER_1  &j_rbrc   &j_rbkt     &j_rp                          &j_ast  &kp SEMICOLON  &j_colon   &kp QUESTION  &kp SLASH
&trans           &trans           &trans    &trans      &trans       &trans    &trans  &trans                 &kp SLASH  &trans        &trans
            >;
            sensor-bindings = <&re_kp>;
        };

        CURSOR {
            bindings = <
&trans          &kp LC(LG(LEFT_ARROW))  &kp LG(UP_ARROW)  &kp LC(LG(RIGHT_ARROW))  &trans                    &trans  &trans  &kp PG_DN       &kp UP_ARROW    &kp PG_UP
&trans          &kp LG(LEFT_ARROW)      &kp LG(DOWN)      &kp LG(RIGHT_ARROW)      &trans                    &trans  &trans  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW
&kp LEFT_SHIFT  &trans                  &trans            &trans                   &trans                    &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
&trans          &trans                  &trans            &trans                   &trans  &trans    &trans  &trans          &trans          &kp HOME        &kp END
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        NUMBER {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                              &kp NUMBER_6            &kp N7              &kp N8                   &kp N9  &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                              &kp LG(LS(LEFT_ARROW))  &kp LG(UP_ARROW)    &kp LG(LS(RIGHT_ARROW))  &kp F9  &kp F10
&kp F6        &kp F7        &kp F8        &trans        &trans                              &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &trans  &trans
&trans        &trans        &trans        &trans        &kp INT_MUHENKAN  &trans    &trans  &trans                                      &trans                   &trans  &trans
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        SCROLL {
             bindings = <
&trans          &kp LC(LG(LEFT_ARROW))  &kp LG(UP_ARROW)  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8    &kp NUMBER_9    &kp KP_PLUS
&trans          &kp LG(LEFT_ARROW)      &kp LG(DOWN)      &kp LG(RIGHT_ARROW)      &trans                    &kp KP_SLASH     &mkp LCLK     &mkp RCLK       &mkp RCLK       &kp KP_MINUS
&kp LEFT_SHIFT  &kp PAGE_DOWN           &kp END           &kp PAGE_UP              &trans                    &kp UNDER        &mkp MCLK     &mkp MCLK       &kp UP_ARROW    &kp ENTER
&trans          &trans                  &trans            &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp LEFT_ARROW  &kp DOWN_ARROW  &trans
            >;
            sensor-bindings = <&mouse_scrl>;
        };

        WIRELESS {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                   &trans &trans &trans &trans &bt BT_CLR_ALL
                &trans        &trans        &trans        &trans        &trans                         &trans &trans &trans &trans &bt BT_CLR
                &trans        &trans        &trans        &trans        &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  
                &trans        &trans        &trans        &trans        &trans        &trans  &trans &studio_unlock        &trans &trans &trans
            >;
        };
    };
};
