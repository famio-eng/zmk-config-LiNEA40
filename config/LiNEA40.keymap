#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "jp.dtsi"

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6


//mouse cursol
&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll
&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>;
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        DeleteKey { bindings = <&kp DEL>; key-positions = <8 7>; };
        InsertKey { bindings = <&kp INS>; key-positions = <6 7>; };
        Enter { bindings = <&kp ENTER>; key-positions = <18 17 16>; };
        PrevClick { bindings = <&mkp MB4>; key-positions = <16 17>; };
        ClickNext { bindings = <&mkp MB5>; key-positions = <17 18>; };
        back { bindings = <&kp BACKSPACE>; key-positions = <8 9>; };
        screenshot { bindings = <&kp PRINTSCREEN>; key-positions = <3 4>; };
        emoji { bindings = <&kp LG(PERIOD)>; key-positions = <2 3>; };
        escape { bindings = <&kp ESCAPE>; key-positions = <1 2>; };
        tab { bindings = <&kp TAB>; key-positions = <11 12>; };
        EN { bindings = <&kp LANG2>; key-positions = <12 13>; };
        JP { bindings = <&kp LANG1>; key-positions = <22 23>; };
        katakana { bindings = <&kp LANG3>; key-positions = <0 1>; };
    }; // <-- combos ノードの終了

    behaviors { // <-- エラー発生箇所の開始行
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
        
        // JIS記号関連のカスタムビヘイビアは引き続き削除
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_win {
            bindings = <
&kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &lt 6 P
&kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &lt 5 BACKSPACE
&kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &mt LESS_THAN COMMA &mt GREATER_THAN PERIOD
&kp LEFT_CONTROL &kp LEFT_WIN &mt LALT GRAVE &none &lt 5 LANG_ZENKAKUHANKAKU &mo 7 &lt 3 ENTER &lt 4 SPACE &lt 7 QUESTION &kp LS(NUMBER_6) &mt JP_UNDER MINUS
            >;
            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        default_layer_mac {
            bindings = <
&kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &lt 6 P
&kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &lt 5 MINUS
&kp Z &kp X &kp C &kp V &kp B &kp N &kp M &mt LESS_THAN COMMA &mt GREATER_THAN PERIOD &mt QUESTION SLASH
&kp LEFT_CONTROL &kp LEFT_WIN &mt LALT GRAVE &none &lt 5 ENTER &lt 3 TAB &lt 3 SPACE &lt 4 ENTER &lt 6 QUESTION &kp BACKSLASH &kp JP_UNDERSCORE
            >;
            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &mkp LCLK &mkp MCLK &mkp RCLK &trans
&trans &trans &trans &trans &trans &trans &mkp LCLK &mkp MCLK &kp UP_ARROW &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        MARK {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUMBER {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >; 
        };

        SCROLL {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &bt BT_CLR
&trans &trans &trans &trans &trans &trans &bootloader &studio_unlock &trans &trans &bt BT_CLR_ALL
            >;
            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        CURSOR {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
