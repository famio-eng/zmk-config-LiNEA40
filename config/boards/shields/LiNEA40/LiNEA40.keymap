#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 600

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol
&mmv {
    delay-ms = <0>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <20>;
    acceleration-exponent = <1>;
};

//mouse scroll
&msc {
    delay-ms = <0>;
    trigger-period-ms = <8>;
    time-to-max-speed-ms = <50>;
    acceleration-exponent = <1>;
};

/ {
    input_processors {
        /* トラックボールの爆速スクロールを抑えるための減速器 */
        zip_wheel_scaler_factor: zip_wheel_scaler_factor {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>, <INPUT_REL_HWHEEL>;
            multiplier = <1>;
            divisor = <4>; 
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_peripheral>;
        status = "okay";
        
        /* オートマウス機能をここに定義。動かすとMOUSE(1)レイヤーへ */
        msl-layers = <MOUSE>;

        scroller {
            layers = <5>; 
            input-processors = <&zip_xy_to_scroll_mapper>, <&zip_wheel_scaler_factor 1 4>;
        };
    };

    combos {
        compatible = "zmk,combos";
        ZenkakuHankaku { bindings = <&kp GRAVE>; key-positions = <11 12>; };
        DeleteKey { bindings = <&kp DEL>; key-positions = <7 8>; };
        InsertKey { bindings = <&kp INS>; key-positions = <6 7>; };
        CenterClick { bindings = <&mkp MB3>; key-positions = <17 16>; };
        RightClick { bindings = <&mkp MB2>; key-positions = <18 17>; };
        PrevClick { bindings = <&mkp MB4>; key-positions = <27 28>; };
        ClickNext { bindings = <&mkp MB5>; key-positions = <26 27>; };
    };

    behaviors {
        /* エンコーダーの挙動：Win/Mac両対応の600設定 */
        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc SCRL_DOWN(600)>, <&msc SCRL_UP(600)>;
            tap-ms = <0>;
        };

        /* 音量調整用の明示的定義 */
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q          &kp W          &kp E                &kp R    &kp T                                    &kp Y        &kp U     &kp I            &kp O        &kp P
                &kp A          &kp S          &kp D                &kp F    &kp G                                    &kp H        &kp J     &kp K            &kp L        &lt 5 MINUS
                &kp Z          &kp X          &kp C                &kp V    &kp B                                    &kp N        &kp M     &kp COMMA        &kp DOT      &mt RIGHT_SHIFT BACKSPACE
                &mt LCTRL ESC  &kp LEFT_WIN   &mt LEFT_ALT GRAVE  &kp INS  &lt 5 ENTER  &lt 2 TAB  &lt 2 BACKSPACE  &lt 4 SPACE            &lt 6 SEMICOLON  &kp INT_YEN  &mt RIGHT_SHIFT SLASH
            >;
            /* 音量操作をここに割り当て */
            sensor-bindings = <&re_kp C_VOL_DN C_VOL_UP>;
        };

        MOUSE {
            bindings = <
                &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;
        };

        MARK {
            bindings = <
                &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT            &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp LBKT
                &kp SLASH &kp N4  &kp N5    &kp SEMI  &kp SEMI             &kp C_MUTE &kp LS(LBKT) &kp RBKT &kp BSLH &kp EQUAL
                &mt LSHFT N0 &kp N1 &kp N2 &kp APOS  &kp SQT               &kp EQUAL  &kp INT3  &kp LS(RBKT) &kp LS(BSLH) &kp LS(INT1)
                &trans    &trans  &trans    &trans    &trans  &trans &trans &trans          &kp ASTRK &kp LPAR &kp LS(QUESTION)
            >;
            sensor-bindings = <&re_kp C_VOL_DN C_VOL_UP>;
        };

        CURSOR {
            bindings = <
                &trans    &kp LC(LG(LEFT)) &kp UP   &kp LC(LG(RIGHT)) &trans          &kp KP_MULTIPLY &kp N7 &kp N8 &kp N9 &kp KP_PLUS
                &trans    &kp LEFT         &kp DOWN &kp RIGHT          &trans          &kp KP_SLASH    &kp N4 &kp N5 &kp N6 &kp KP_MINUS
                &kp HOME  &kp PG_DN        &kp END  &kp PG_UP          &trans          &kp UNDER       &kp N1 &kp N2 &kp N3 &kp ENTER
                &trans    &trans           &trans   &trans             &trans &trans &kp ENTER &kp N0      &kp DOT &kp ENTER &kp QUESTION
            >;
        };

        FUNCTION {
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4   &kp F5                        &trans  &trans  &kp LA(PSCRN) &trans  &kp LC(LA(DEL))
                &kp F6  &kp F7  &kp F8  &kp F9   &kp F10                       &trans  &trans  &kp LS(LG(S))  &trans  &kp LC(LS(ESC))
                &trans  &trans  &trans  &kp F11  &kp F12                       &kp C_MUTE &trans &trans      &trans  &kp LC(LA(INS))
                &trans  &trans  &trans  &trans   &trans  &trans &trans &trans          &trans                &trans  &trans
            >;
            /* FUNCTIONレイヤー時はエンコーダーをスクロール挙動に */
            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        SCROLL {
             bindings = <
                &trans    &kp LC(LG(LEFT)) &kp UP   &kp LC(LG(RIGHT)) &trans          &kp KP_MULTIPLY &kp N7 &kp N8 &kp N9 &kp KP_PLUS
                &trans    &kp LEFT         &kp DOWN &kp RIGHT          &trans          &kp KP_SLASH    &kp N4 &kp N5 &kp N6 &kp KP_MINUS
                &kp HOME  &kp PG_DN        &kp END  &kp PG_UP          &trans          &kp UNDER       &kp N1 &kp N2 &kp N3 &kp ENTER
                &trans    &trans           &trans   &trans             &trans &trans &trans &kp N0          &kp N0 &kp DOT &kp QUESTION
            >;
        };

        WIRELESS {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &trans &trans &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans
                &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &bt BT_CLR
                &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans &bt BT_CLR_ALL
            >;
        };
    };
};
