#include "LiNEA40.dtsi"
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/ {
    /* 1. 通常移動用プロセッサ */
    trackball_runtime_proc: trackball_runtime_proc {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "TBall";
        /* 0x00 = REL_X, 0x01 = REL_Y */
        x-codes = <0x00>;
        y-codes = <0x01>;
    };

    /* 2. スクロール用の減速スケーラー */
    trackball_scroll_scaler: trackball_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <0>;
        type = <0x02>; /* EV_REL */
        codes = <0x00 0x01>; /* REL_X, REL_Y を対象 */
        multiplier = <1>;
        divisor = <16>; 
    };

    /* 3. スクロール変換プロセッサ */
    trackball_scroll_proc: trackball_scroll_proc {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "Scrl";
        /* 0x06 = REL_HWHEEL (横), 0x08 = REL_WHEEL (縦) */
        x-codes = <0x06>;
        y-codes = <0x08>;
    };

    /* リスナー */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";
        input-processors = 
            <&trackball_runtime_proc>, 
            <&trackball_scroll_scaler>, 
            <&trackball_scroll_proc>;
    };
};
