#include "LiNEA40.dtsi"
&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH> //col0-D10
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>  //col1-D9
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>  //col2-D8
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>  //col3-D7
        , <&gpio0 10 GPIO_ACTIVE_HIGH>  //col4-NFC2
        ;
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

    };
};


&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>   // SCLK-D5
                  , <NRF_PSEL(SPIM_MOSI, 0, 4)>  // SDIO-D4
                  , <NRF_PSEL(SPIM_MISO, 0, 4)>  // SDIO-D4
                  ;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>   // SCLK-D5
                  , <NRF_PSEL(SPIM_MOSI, 0, 4)>  // SDIO-D4
                  , <NRF_PSEL(SPIM_MISO, 0, 4)>  // SDIO-D4
                  ;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; //NCS-NFC1

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; //MOT-D6
        automouse-layer = <2>;
        snipe-layers = <5>;
        scroll-layers = <5>;
        //scroll-layers = <4 5 6>;
    };
};

&trackball_listener {
    status = "okay";
    device = <&trackball>;
};

&behaviors {
    re_kp: sensor_rotate_kp {
        compatible = "zmk,behavior-sensor-rotate-var";
        #sensor-binding-cells = <2>;
        bindings = <&kp>, <&kp>;
    };

    mouse_scrl: mouse_wheel_scrl {
        compatible = "zmk,behavior-sensor-rotate-var";
        #sensor-binding-cells = <2>;
        bindings = <&msc>, <&msc>;

        tap-ms = <20>;
    };

    // --- 💡 日本語入力用カスタムキー定義の追記 (ノード名重複を解消) ---
    // 記号系カスタムキー
    jp_amp: jp_amp { compatible = "zmk,behavior-key-press"; label = "&"; #binding-cells = <0>; bindings = <&kp LS(N7)>; }; // &
    jp_quote: jp_quote { compatible = "zmk,behavior-key-press"; label = "'"; #binding-cells = <0>; bindings = <&kp QUOT>; }; // '
    jp_equal: jp_equal { compatible = "zmk,behavior-key-press"; label = "="; #binding-cells = <0>; bindings = <&kp EQUAL>; }; // =
    jp_caret: jp_caret { compatible = "zmk,behavior-key-press"; label = "^"; #binding-cells = <0>; bindings = <&kp LS(N6)>; }; // ^
    jp_yen: jp_yen { compatible = "zmk,behavior-key-press"; label = "¥"; #binding-cells = <0>; bindings = <&kp INT1>; }; // ¥ (日本語キーボード)
    jp_plus: jp_plus { compatible = "zmk,behavior-key-press"; label = "+"; #binding-cells = <0>; bindings = <&kp LS(EQUAL)>; }; // +
    jp_tilde: jp_tilde { compatible = "zmk,behavior-key-press"; label = "~"; #binding-cells = <0>; bindings = <&kp LS(GRAVE)>; }; // ~
    jp_pipe: jp_pipe { compatible = "zmk,behavior-key-press"; label = "|"; #binding-cells = <0>; bindings = <&kp LS(BSLH)>; }; // |
    jp_at: jp_at { compatible = "zmk,behavior-key-press"; label = "@"; #binding-cells = <0>; bindings = <&kp LS(N2)>; }; // @
    jp_colon: jp_colon { compatible = "zmk,behavior-key-press"; label = ":"; #binding-cells = <0>; bindings = <&kp LS(SCLN)>; }; // :
    jp_asterisk: jp_asterisk { compatible = "zmk,behavior-key-press"; label = "*"; #binding-cells = <0>; bindings = <&kp LS(N8)>; }; // *
    jp_grave: jp_grave { compatible = "zmk,behavior-key-press"; label = "`"; #binding-cells = <0>; bindings = <&kp GRAVE>; }; // `
    jp_underscore: jp_underscore { compatible = "zmk,behavior-key-press"; label = "_"; #binding-cells = <0>; bindings = <&kp LS(MINUS)>; }; // _
    jp_lbracket: jp_lbracket { compatible = "zmk,behavior-key-press"; label = "["; #binding-cells = <0>; bindings = <&kp LBKT>; }; // [
    jp_rbracket: jp_rbracket { compatible = "zmk,behavior-key-press"; label = "]"; #binding-cells = <0>; bindings = <&kp RBKT>; }; // ]
    jp_lparen: jp_lparen { compatible = "zmk,behavior-key-press"; label = "("; #binding-cells = <0>; bindings = <&kp LS(N9)>; }; // (
    jp_rparen: jp_rparen { compatible = "zmk,behavior-key-press"; label = ")"; #binding-cells = <0>; bindings = <&kp LS(N0)>; }; // )
    jp_lbrace: jp_lbrace { compatible = "zmk,behavior-key-press"; label = "{"; #binding-cells = <0>; bindings = <&kp LS(LBKT)>; }; // {
    jp_rbrace: jp_rbrace { compatible = "zmk,behavior-key-press"; label = "}"; #binding-cells = <0>; bindings = <&kp LS(RBKT)>; }; // }

    // 特殊キー（英数、半角/全角）
    jp_eisuu: jp_eisuu { compatible = "zmk,behavior-key-press"; label = "英数"; #binding-cells = <0>; bindings = <&kp LANG2>; }; // 英数
    jp_zenhan: jp_zenhan { compatible = "zmk,behavior-key-press"; label = "半角/全角"; #binding-cells = <0>; bindings = <&kp LANG1>; }; // 半角/全角
};
