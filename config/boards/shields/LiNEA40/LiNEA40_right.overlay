#include "LiNEA40.dtsi"
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/ {
    /* 1. 通常移動用プロセッサ (Studio上の "Mouse" ラベル) */
    trackball_runtime_proc: trackball_runtime_proc {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "Mouse";
        
        /* 必須項目の追加: REL_X(0x00), REL_Y(0x01) */
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;

        /* 初期設定としてY軸反転を適用 */
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;
    };

    /* 2. スクロール用プロセッサ (Studio上の "Scroll" ラベル) */
    trackball_scroll_proc: trackball_scroll_proc {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "Scroll";

        /* 必須項目の追加 */
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;

        /* スクロールへの変換プロセッサを適用 */
        input-processors = <&zip_xy_to_scroll_mapper>;
    };

    /* リスナー設定 */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";

        /* デフォルトの挙動 */
        input-processors = <&trackball_runtime_proc>;

        /* オートマウス設定（レイヤー2へ遷移） */
        msl-layers = <2>;      
        msl-timeout-ms = <500>; 

        /* スクロール設定（レイヤー6で切り替え） */
        scroller {
            layers = <6>;
            input-processors = <&trackball_scroll_proc>;
        };
    };
};

/* --- SPI & センサー設定 (物理接続の根幹：変更なし) --- */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
