// config/boards/shields/LiNEA40/LiNEA40_right.overlay
#include "LiNEA40.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK, 0, 5)   // SCLK-D5
                NRF_PSEL(SPIM_MOSI, 0, 4)  // SDIO-D4
                NRF_PSEL(SPIM_MISO, 0, 4)  // SDIO-D4
            >;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK, 0, 5)
                NRF_PSEL(SPIM_MOSI, 0, 4)
                NRF_PSEL(SPIM_MISO, 0, 4)
            >;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; // NCS (NFC1)

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";      // Zephyr 標準ドライバ
        reg = <0>;
        spi-max-frequency = <2000000>;

        // 割り込みピン: Zephyr の binding では motion-gpios
        motion-gpios = <&xiao_d 6 GPIO_ACTIVE_LOW>;

        // 軸コードの指定（Zephyr binding では zephyr,axis-x / -y）
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;

        // 感度（200〜3200 の 200刻み）: cpi ではなく res-cpi
        res-cpi = <800>;

        // 任意: 追従性を広げるスマートモード
        // smart-mode;

        // 任意: 反転が必要なら有効化
        // invert-x;
        // invert-y;
    };
}

// ★ “最小検証中” は trackball_listener を作らない（追加処理を一切差さない）
