#include "LiNEA40.dtsi"
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/* --- 1. 物理センサー(SPI)の定義 --- */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    /* ここで 'trackball' ラベルを定義しています */
    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

/* --- 2. 入力プロセッサとリスナーの定義 --- */
/ {
    /* 通常移動用 */
    trackball_runtime_proc: trackball_runtime_proc {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "Mouse";
        x-codes = <0x00>; /* REL_X */
        y-codes = <0x01>; /* REL_Y */
    };

/* 2. スクロール用の減速スケーラー */
    trackball_scroll_scaler: trackball_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        /* エラーに基づき 0 から 2 に変更 */
        #input-processor-cells = <2>; 
        type = <0x02>; /* EV_REL */
        /* codes は引数として渡すため、ここでは空にするか削除します */
        multiplier = <1>;
        divisor = <16>; 
    };

    /* スクロール変換用 */
    trackball_scroll_proc: trackball_scroll_proc {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "Scroll";
        x-codes = <0x06>; /* REL_HWHEEL */
        y-codes = <0x08>; /* REL_WHEEL */
    };

    /* リスナー：上記で定義した 'trackball' を参照 */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay";
        input-processors = 
            <&trackball_runtime_proc>, 
            /* スケーラーに REL_X(0) と REL_Y(1) を適用するように指定 */
            <&trackball_scroll_scaler 0x00 0x01>, 
            <&trackball_scroll_proc>;
    };
};
