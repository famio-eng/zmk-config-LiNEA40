// config/boards/shields/LiNEA40/LiNEA40_right.overlay
#include "LiNEA40.dtsi"

// ★ 今は input processors は使わない（最小検証のため include しない）
// #include <input/processors.dtsi>
// #include <input/processors/runtime-input-processor.dtsi>

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK, 0, 5)   // SCLK-D5
                NRF_PSEL(SPIM_MOSI, 0, 4)  // SDIO-D4
                NRF_PSEL(SPIM_MISO, 0, 4)  // SDIO-D4
            >;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK, 0, 5)
                NRF_PSEL(SPIM_MOSI, 0, 4)
                NRF_PSEL(SPIM_MISO, 0, 4)
            >;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; // NCS-NFC1

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;

        // MOT(D6) 割り込み。pull-up は設計に合わせて指定。
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        // 念のため CPI を明示（任意）
        cpi = <800>;

        // ★ 余計なモードは今は入れない（競合/誤動作の温床）
        // automouse-layer = <...>;   // 使わない
        // snipe-layers = <...>;      // 使わない
        // scroll-layers = <...>;     // 使わない
    };
};

// ★ “最小” 検証中は trackball_listener を作らない
// / {
//     trackball_listener: trackball_listener { ... };
// };
