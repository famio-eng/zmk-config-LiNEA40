#include "LiNEA40.dtsi"
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH> //col0-D10
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>  //col1-D9
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>  //col2-D8
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>  //col3-D7
        , <&gpio0 10 GPIO_ACTIVE_HIGH>  //col4-NFC2
        ;
};

//==========Input Processor設定========
&zip_temp_layer {
    excluded-positions = <
        6 // U
        7 // I
        16 // J
        17 // K
        18 // l
        26 // N
        27 // M
    >;
    require-prior-idle-ms = <200>;
};

// トラックボールの設定 (右手側)
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    
    // --- [修正開始: ダミーPinctrlノードの参照] ---
    // pinctrl-0 エラーを回避するため、ダミーノードを参照します。
    pinctrl-names = "default";
    pinctrl-0 = <&spi0_dummy_default>;
    // --- [修正終了] ---

    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; //NCS-NFC1

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; //MOT-D6

        /* 感度調整: トラックボールの基本感度を下げています */
        cpi = <600>; 
        
        snipe-layers = <5>;
        scroll-layers = <5>;
    };
};

// トラックボールのリスナー（Auto Mouse Layer用）
/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&zip_temp_layer 2 1000>; // 動きが止まってから1秒(1000ms)でレイヤー解除
    };
    
    // --- [追加: ダミーのPinctrlノード] ---
    // spi0に必須のpinctrl-0プロパティを満たすための空のノードを定義します。
    pinctrl {
        spi0_dummy_default: spi0_dummy_default {
        };
    };
    // --- [追加終了] ---
};

/* 左エンコーダー（左手側）の設定を調整 */
&left_encoder {
    status = "okay";
    /* 解像度調整: 4回回して1回キーイベントを発生させる設定 */
    resolution = <4>; 
};
