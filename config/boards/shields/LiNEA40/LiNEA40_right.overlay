#include "LiNEA40.dtsi"
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/ {
    /* 1. マウス移動用のランタイムプロセッサ実体 */
    mouse_runtime_input_processor: mouse_runtime_input_processor {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "Trackball";
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
    };

    /* 2. スクロール用のランタイムプロセッサ実体 */
    scroll_runtime_input_processor: scroll_runtime_input_processor {
        compatible = "zmk,input-processor-runtime";
        #input-processor-cells = <0>;
        processor-label = "Scroll";
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
    };

    /* 3. XY移動をスクロールに変換するためのスケーラー */
    zip_xy_to_scroll_mapper: zip_xy_to_scroll_mapper {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X>, <INPUT_REL_Y>;
        track-remainders;
    };

    /* 4. リスナー定義 */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;      
        input-processors = <&mouse_runtime_input_processor>;
        status = "okay";

        /* 修正ポイント：名前を scroller から scroll-process に変更し、
           プロセッサの参照形式を整理しました */
        scroll-process {
           layers = <5>; 
           input-processors = <&zip_xy_to_scroll_mapper 1 1>, <&scroll_runtime_input_processor>;
        };
    };
};
 

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
