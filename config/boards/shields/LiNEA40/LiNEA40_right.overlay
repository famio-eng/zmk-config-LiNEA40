// --- LiNEA40_right.overlay (緊急用ミニマム) ---
#include "LiNEA40.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {

    spi0_default: spi0_default {
        group1 {
            /* SCLK-D5, SDIO-D4, SDIO-D4 */
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; // NCS (NFC1)

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";     // ※ Zephyr 3.5系での外部ドライバ想定
        reg = <0>;
        spi-max-frequency = <2000000>;

        // 割り込みピン：古い系の driver は irq-gpios を使用
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        // 入力イベント/軸コード（古い系は evt-type / x-input-code / y-input-code）
        evt-type     = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        // ★ ここでは cpi/res-cpi 等は一切書かない（世代差の食い違いを回避）
    };
}

// ★ 最小検証のためリスナは作らない。AMLやRuntime IPは後で戻す
