/*
 * 日本語配列 (JIS) 変換定義
 */

#include <dt-bindings/zmk/keys.h>

// ---------------------------------------------------------
// 基本定義 (ZMK標準コード/HIDコードへのマッピング)
// ---------------------------------------------------------
#define JP_ZHTG GRAVE         // 半角/全角

// **修正箇所: 日本語配列固有のキーはHIDコードで直接定義 (安定化)**
#define JP_YEN  0x89          // ¥ (INT3, HID Usage ID 0x89)
#define JP_PIPE LS(0x89)      // |
#define JP_KANA 0x90          // かな (LANGUAGE_1, HID Usage ID 0x90)
#define JP_EISU 0x91          // 英数 (LANGUAGE_2, HID Usage ID 0x91)
#define JP_HANZEN JP_ZHTG     // 半角/全角

#define JP_AT   LBKT          // @ (US: [)
#define JP_QUOT LS(N2)        // " (US: Shift+2)
#define JP_AMPS LS(N6)        // & (US: Shift+6)
#define JP_SQT  LS(N7)        // ' (US: Shift+7)
#define JP_LPAR LS(N8)        // ( (US: Shift+8)
#define JP_RPAR LS(N9)        // ) (US: Shift+9)
#define JP_EQL  LS(MINUS)     // = (US: Shift+-)
#define JP_PLUS LS(SEMI)      // + (US: Shift+;)
#define JP_ASTR LS(SQT)       // * (US: Shift+')
#define JP_LBRC RBKT          // [ (US: ])
#define JP_RBRC NUHS          // ] (US: Non-US \)
#define JP_LCBR LS(RBKT)      // { (US: Shift+])
#define JP_RCBR LS(NUHS)      // } (US: Shift+Non-US \)
#define JP_COLN SQT           // : (US: ')
#define JP_TILD LS(EQUAL)     // ~ (US: Shift+=)
#define JP_UNDER LS(0x87)     // _ (ろ/INT1, HID Usage ID 0x87) **修正**

// ---------------------------------------------------------
// 互換性レイヤー
// ---------------------------------------------------------
#define JP_DQUOTE JP_QUOT
#define JP_AMPERSAND JP_AMPS
#define JP_QUOTE JP_SQT
#define JP_EQUAL JP_EQL
#define JP_CARET EQUAL         // ^ (US: =)
#define JP_TILDE JP_TILD
#define JP_COLON JP_COLN
#define JP_ASTERISK JP_ASTR
#define JP_BACKQUOTE LEFT_BRACE
#define JP_UNDERSCORE JP_UNDER

#define JP_LEFT_BRACKET JP_LBRC
#define JP_RIGHT_BRACKET JP_RBRC

#define JP_LPAREN JP_LPAR
#define JP_RPAREN JP_RPAR
#define JP_LBRACE JP_LCBR
#define JP_RBRACE JP_RCBR

// 日本語入力切り替え関連
#define JP_KANA_KEY JP_KANA      // かな
#define JP_EISU_KEY JP_EISU      // 英数
#define JP_HANZEN_KEY JP_HANZEN    // 半角/全角

#define JP_AT_SYM JP_AT
